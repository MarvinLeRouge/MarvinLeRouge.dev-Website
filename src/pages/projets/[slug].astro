---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import ProjectSheet from '../../components/ProjectSheet.astro';
import { sheetRoutes, sheetSlug } from '../../content/projects';
import { SITE_NAME } from '../../i18n/identity';
import BaseLayout from '../../layouts/BaseLayout.astro';
// Blocking head script: picks the view before the first paint (see sheet-view.ts and BaseLayout).
import sheetViewScript from '../../scripts/sheet-view-entry.ts?worker&url';

export async function getStaticPaths() {
  // Drafts are only built by the development server, for review.
  return sheetRoutes(await getCollection('projects'), 'fr', import.meta.env.DEV);
}

const { sheet, translations } = Astro.props;
// Link preview: cut at full scale from the full size screenshot when there is one (see
// src/pages/og/projects), else the screenshot cropped to the 1200 x 630 Open Graph format.
const { full, src } = sheet.data.screenshot;
const preview = full
  ? { src: `/og/projects/${sheetSlug(sheet.id)}.png` }
  : await getImage({ src, width: 1200, height: 630, fit: 'cover', format: 'png' });
---

<BaseLayout
  title={`${sheet.data.title} | ${SITE_NAME}`}
  locale="fr"
  translations={translations}
  meta={{
    description: sheet.data.tagline,
    image: preview.src,
    imageAlt: sheet.data.screenshot.alt,
  }}
>
  <script
    slot="head"
    is:inline
    src={sheetViewScript}
    type={import.meta.env.DEV ? 'module' : undefined}
  ></script>
  <ProjectSheet sheet={sheet} locale="fr" translations={translations} />
</BaseLayout>
