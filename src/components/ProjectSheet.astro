---
import { Picture } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/locales';
import { UI } from '../i18n/ui';
import { LIGHTBOX_ATTRIBUTE } from '../scripts/lightbox';
import { PANEL_ATTRIBUTE, TAB_ATTRIBUTE, VIEWS } from '../scripts/sheet-view';
// Loaded on sheets with a full size screenshot only, see lightbox.ts.
import lightboxScript from '../scripts/lightbox-entry.ts?worker&url';
import SiteBanner from './SiteBanner.astro';

interface Props {
  sheet: CollectionEntry<'projects'>;
  locale: Locale;
  /** Path of the sheet in each locale, when it is translated. */
  translations?: Readonly<Record<Locale, string>>;
}

const { sheet, locale, translations } = Astro.props;
const { data } = sheet;
const t = UI[locale].sheet;
const { Content } = await render(sheet);
// AVIF, with the source format as fallback: palette PNG screenshots get larger as WebP.
const screenshotImage = {
  src: data.screenshot.src,
  alt: data.screenshot.alt,
  formats: ['avif'],
  fallbackFormat: data.screenshot.src.format,
};
const viewTitles = { recruiter: t.recruiterView, 'lead-dev': t.leadDevView };
---

<SiteBanner locale={locale} paths={translations} />

<main class="project-sheet">
  <header>
    {data.draft && <p class="draft-notice">{t.draftNotice}</p>}
    <h1>{data.title}</h1>
    <p class="tagline">{data.tagline}</p>
    {data.lastAction && (
      <p class="last-action">
        <span class="label">{t.lastAction}</span> {data.lastAction}
      </p>
    )}
    <!-- Hidden without JavaScript, where both views are shown one after the other. -->
    <div class="view-tabs" role="tablist" aria-label={t.viewSwitcherLabel}>
      {VIEWS.map((view, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${view}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          {...{ [TAB_ATTRIBUTE]: view }}
        >
          {viewTitles[view]}
        </button>
      ))}
    </div>
  </header>

  <section
    id="view-recruiter"
    aria-labelledby="recruiter-title"
    {...{ [PANEL_ATTRIBUTE]: 'recruiter' }}
  >
    <h2 id="recruiter-title" class="view-title">
      {t.recruiterView}
    </h2>
    {data.screenshot.full ? (
      <figure class="screenshot">
        <a
          href={data.screenshot.full.src}
          aria-describedby="screenshot-hint"
          {...{ [LIGHTBOX_ATTRIBUTE]: t.closeScreenshot }}
        >
          <Picture {...screenshotImage} />
        </a>
        <figcaption id="screenshot-hint">{t.fullScreenshot}</figcaption>
      </figure>
    ) : (
      <Picture {...screenshotImage} />
    )}
    <dl>
      <dt>{t.problem}</dt>
      <dd>{data.recruiter.problem}</dd>
      <dt>{t.built}</dt>
      <dd>{data.recruiter.built}</dd>
      <dt>{t.result}</dt>
      <dd>{data.recruiter.result}</dd>
      <dt>{t.keywords}</dt>
      <dd>{data.keywords.join(', ')}</dd>
      <dt>{t.stack}</dt>
      <dd>{data.stack.join(', ')}</dd>
    </dl>
    <ul class="sheet-links">
      <li>
        <a href={data.repo}>
          <span aria-hidden="true">→ </span>
          {t.repo}
        </a>
      </li>
      {data.demo && (
        <li>
          <a href={data.demo}>
            <span aria-hidden="true">→ </span>
            {t.demo}
          </a>
        </li>
      )}
    </ul>
  </section>

  <section
    id="view-lead-dev"
    aria-labelledby="lead-dev-title"
    {...{ [PANEL_ATTRIBUTE]: 'lead-dev' }}
  >
    <h2 id="lead-dev-title" class="view-title">
      {t.leadDevView}
    </h2>
    <Content />
    {data.adrs && (
      <>
        <h3>{t.adrs}</h3>
        <ul>
          {data.adrs.map((adr) => (
            <li>
              <a href={adr.url}>{adr.title}</a>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>
</main>

{data.screenshot.full && (
  <script
    is:inline
    defer
    src={lightboxScript}
    type={import.meta.env.DEV ? 'module' : undefined}
  ></script>
)}
