---
import { homePath, LOCALES, type Locale } from '../i18n/locales';
import { UI } from '../i18n/ui';
import { SWITCH_ATTRIBUTE } from '../scripts/language-preference';

interface Props {
  locale: Locale;
  /** Path of the current page in each locale. Defaults to the homepages. */
  paths?: Readonly<Record<Locale, string>>;
}

const { locale, paths } = Astro.props;
---

<nav class="language-switcher" aria-label={UI[locale].languageSwitcherLabel}>
  <ul>
    {LOCALES.map((target) => (
      <li>
        <a
          href={paths?.[target] ?? homePath(target)}
          hreflang={target}
          lang={target}
          aria-current={target === locale ? 'page' : undefined}
          {...{ [SWITCH_ATTRIBUTE]: target }}
        >
          {target.toUpperCase()}
          <span class="visually-hidden">{UI[target].languageName}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
